#!/usr/bin/env bash
# gent-clear — do exactly what typing /clear does in THIS box's claude session,
# then re-greet the fresh session with the box's hello — but ONLY once the clear
# is observed to have actually landed.
#
#   gent-clear -m "PR #42 is green but unmerged — merge it, then resume backlog"
#   gent-clear              # no note yet → stages a DRAFT and clears NOTHING
#   gent-clear --file       # clear, taking the handoff from that draft
#   gent-clear --none       # clear with no handoff at all
#
# WHY THIS PARSES LIKE `git commit`. It used to take a bare positional note, so
# every argument was a note — including `--help`. An agent reaching for the
# manual wiped its own context instead. Twice. A command whose whole job is to
# destroy context cannot have a "swallow anything" argument, so now:
#
#   * the note arrives ONLY via -m / --file — never from a stray argument;
#   * any unknown or malformed argument is a usage error, and clears nothing;
#   * a bare `gent-clear` clears nothing either — it opens a draft to write the
#     handoff into, the way `git commit` with no -m opens an editor.
#
# Nothing you can typo at this command costs you a session.
#
# THE HANDOFF is an instruction TO your post-clear self, delivered with the hello
# as the fresh session's first prompt. Write it for a reader that remembers
# nothing: name the task, the branch, the file, the next step. Without one a
# cleared box wakes up oriented (it has the hello) but idle — it knows who it is,
# not what you were in the middle of. Which is why "no note" is a thing you say
# on purpose (`--none`, or an untouched draft), not a thing you get by default.
#
# RUN IT AS YOUR FINAL ACTION — that means the -m / --file / --none forms, the
# ones that actually clear. gent-clear runs via the Bash tool, so the pane is
# busy and the "/clear" keystroke QUEUES behind the current turn; it fires once
# the turn ends. So output nothing after calling those — anything you say keeps
# the turn alive and delays (or strands) the clear. The bare staging form is the
# opposite: it's a mid-turn step, and you're expected to keep working after it.
#
# `/clear` does not edit the current transcript: it FREEZES it and starts a brand-
# new <id>.jsonl. We use that new file as PROOF the clear happened — only once it
# appears do we replay the hello (and the note). If it never appears (e.g. the
# turn never ended, so the queued keystroke never fired), we greet NOTHING:
# pasting a hello into a still-uncleared session is the exact bug this replaces.
# Dropping the note there is right, not a loss — the clear didn't happen, so the
# context it was handing off to never existed and the old session still has
# everything. A missed greet is recoverable (`gent-hello "<note>"`); a false greet
# into stale context just looks broken.
#
# The supervisor (~/.gent-run.sh) independently resumes the NEWEST transcript, so
# the new post-clear session is what survives the next restart — no bookkeeping
# here; the clear sticks on its own.
set -u

STATE="${GENT_STATE_DIR:-$HOME/.local/state/gent}"
DRAFT="${GENT_HANDOFF_PATH:-$STATE/handoff.md}"

synopsis() {
  cat <<USAGE
gent-clear — /clear this box's claude session, then re-greet it.

  gent-clear -m "<handoff>"   clear, handing that note to the fresh session
  gent-clear                  stage a handoff draft — CLEARS NOTHING
  gent-clear --file [path]    clear, taking the handoff from the draft
                              (default: $DRAFT)
  gent-clear --none           clear with no handoff at all
  gent-clear --help           this, in full
USAGE
}

usage() {
  synopsis
  cat <<'USAGE'

The handoff is a HANDOFF to your post-clear self, delivered with the box's hello
as the fresh session's first prompt. Write it as an instruction TO a session that
remembers nothing: name the task, the branch, the file, the next step. Without
one, a cleared box wakes up oriented but idle — so "no handoff" is something you
say deliberately (--none, or an untouched draft), not something you fall into.

Bare `gent-clear` never clears: it writes a draft file, tells you where, and
waits. Write the handoff into it, then `gent-clear --file`. Leave it untouched
and `--file` still clears — just with nothing handed over.

The clearing forms (-m / --file / --none) must be your FINAL action, with no
output after: the /clear keystroke queues behind the current turn and only fires
once the turn ends. The greet is replayed only after a brand-new transcript
proves the clear actually happened; if it never lands, nothing is greeted
(recover with `gent-hello "<note>"`).
USAGE
}

# Everything below the comment lines, with leading blank lines trimmed ($(...)
# eats the trailing ones). All-comments or absent ⇒ empty ⇒ "no handoff".
draft_note() { [ -f "$DRAFT" ] && sed -e '/^[[:space:]]*#/d' -e '/./,$!d' "$DRAFT"; }

MODE=stage NOTE=""
if [ "$#" -gt 0 ]; then
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -m|--message)
      [ "$#" -ge 2 ] || { echo "gent-clear: -m needs a note (nothing cleared)" >&2; synopsis >&2; exit 2; }
      MODE=clear NOTE="$2"; shift 2 ;;
    -f|--file)
      MODE=from-draft
      if [ "$#" -ge 2 ]; then DRAFT="$2"; shift 2; else shift; fi ;;
    -n|--none|--no-note) MODE=clear NOTE=""; shift ;;
    -*) echo "gent-clear: unknown option: $1 (nothing cleared)" >&2; synopsis >&2; exit 2 ;;
    # The old shape. Loud rather than helpful-by-guessing: a bare argument is
    # exactly what used to turn `--help` into a wiped session.
    *) echo "gent-clear: a bare argument is not a handoff any more — use -m (nothing cleared)" >&2
       echo "gent-clear: did you mean:  gent-clear -m \"$1\"" >&2
       synopsis >&2; exit 2 ;;
  esac
  [ "$#" -eq 0 ] || { echo "gent-clear: unexpected extra argument: $1 (nothing cleared)" >&2; synopsis >&2; exit 2; }
fi

# --- stage: write the draft, clear nothing -----------------------------------
if [ "$MODE" = stage ]; then
  pending="$(draft_note || true)"
  if [ -n "$pending" ]; then
    # A draft with real content is someone's unfinished handoff — never clobber
    # it, just show it back and point at the command that spends it.
    echo "gent-clear: NOTHING CLEARED — a handoff draft is already waiting at $DRAFT:" >&2
    printf '%s\n' "$pending" | sed 's/^/  | /' >&2
    echo "gent-clear: clear with it -> gent-clear --file   |   rewrite it first, or gent-clear --none" >&2
    exit 0
  fi
  mkdir -p "$(dirname "$DRAFT")" 2>/dev/null || true
  cat > "$DRAFT" <<'TEMPLATE'
# Handoff to your post-clear self. Everything below the '#' lines is sent to the
# fresh session together with the box's hello, as its very first prompt.
#
# It remembers NOTHING. Name the task, the branch, the file, the next step —
# instructions TO it, not notes about it. Multi-line is fine.
#
# Then run:  gent-clear --file
# Nothing carries over? Leave this untouched and run `gent-clear --file` anyway
# (or `gent-clear --none`) — the session still clears, just with no handoff.
TEMPLATE
  echo "gent-clear: NOTHING CLEARED YET — write your handoff into $DRAFT, then run: gent-clear --file" >&2
  echo "gent-clear: truly finished and nothing carries over? gent-clear --none" >&2
  exit 0
fi

# --- from-draft: spend the draft ---------------------------------------------
if [ "$MODE" = from-draft ]; then
  [ -f "$DRAFT" ] || { echo "gent-clear: no handoff draft at $DRAFT (nothing cleared) — run bare \`gent-clear\` to start one, or \`gent-clear --none\`" >&2; exit 2; }
  NOTE="$(draft_note)"
  # Untouched draft = the dismissal. Clearing with no handoff is a legitimate
  # answer; it just has to be one you gave.
  [ -n "$NOTE" ] || echo "gent-clear: draft left empty — clearing with no handoff" >&2
fi

# WHICH SESSION. Boxes run their claude in tmux session `gent`; the HOST runs its own in a session
# named by fleet.json (`host` by default), and that session is a claude session like any other —
# `gent host up` even gives its repo the same in-repo memory a box gets. It just had no way to
# clear itself, because this script named `gent` in four places. So the session is a parameter with
# the box default baked in: unset -> `gent`, and every box behaves exactly as before.
SESSION="${GENT_TMUX_SESSION:-gent}"
PANE="$SESSION:claude"
REPO="${GENT_REPO_DIR:-$(pwd)}"
PROJ="$HOME/.claude/projects/$(printf '%s' "$REPO" | sed 's#/#-#g')"

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "gent-clear: no '$SESSION' tmux session — nothing to clear" >&2
  exit 1
fi

# The draft is spent the moment we commit to the clear: keep it as .sent for
# forensics, but out of the way, so a later bare `gent-clear` starts fresh
# instead of re-handing an old note to an unrelated session.
[ "$MODE" = from-draft ] && mv -f "$DRAFT" "$DRAFT.sent" 2>/dev/null

# The session transcripts that exist RIGHT NOW. /clear starts a brand-new one, so
# the watcher waits for a filename to APPEAR — the whole (name-sorted) listing is
# the fingerprint. Do NOT narrow this to `ls -t | head -1`: claude writes a last
# line to the OLD transcript ~100ms AFTER creating the new one, so "newest" stays
# the old file until something happens to touch the new one — which, in a freshly
# cleared and therefore idle session, may be minutes away or never. That race ate
# the greet silently; a set comparison can't lose it.
before="$(ls "$PROJ"/*.jsonl 2>/dev/null || true)"

# Type /clear. Busy pane -> queues behind the turn -> fires when the turn ends.
tmux send-keys -t "$PANE" "/clear" Enter

# Detached watcher (setsid + closed stdio) so it OUTLIVES both this Bash tool call
# and the model turn that ends right after: wait for the clear to land, then — once
# the fresh TUI settles — replay the hello.
export GENT_PANE="$PANE" GENT_PROJ="$PROJ" GENT_BEFORE="$before" GENT_NOTE="$NOTE" GENT_SESSION="$SESSION"
setsid bash -c '
  cleared=0
  for _ in $(seq 1 300); do
    tmux has-session -t "$GENT_SESSION" 2>/dev/null || exit 0
    now="$(ls "$GENT_PROJ"/*.jsonl 2>/dev/null || true)"
    [ -n "$now" ] && [ "$now" != "$GENT_BEFORE" ] && { cleared=1; break; }
    sleep 1
  done
  [ "$cleared" = 1 ] || { echo "gent-clear: clear never landed (turn not ended?) — no re-greet" >&2; exit 0; }
  # Wait for the fresh session to go idle — same gate as the startup greet: pane
  # unchanged for a few seconds and not showing "esc to interrupt" — then greet.
  prev=""; stable=0; ready=0
  for _ in $(seq 1 300); do
    tmux has-session -t "$GENT_SESSION" 2>/dev/null || exit 0
    cur="$(tmux capture-pane -p -t "$GENT_PANE" 2>/dev/null || true)"
    if [ -n "$cur" ] && [ "$cur" = "$prev" ] && ! printf "%s" "$cur" | grep -q "esc to interrupt"; then
      stable=$((stable + 1)); [ "$stable" -ge 3 ] && { ready=1; break; }
    else stable=0; fi
    prev="$cur"; sleep 1
  done
  [ "$ready" = 1 ] && gent-hello "$GENT_NOTE" || echo "gent-clear: fresh session never went idle — greet skipped (run gent-hello)" >&2
' </dev/null >/dev/null 2>&1 &

if [ -n "$NOTE" ]; then
  echo "gent-clear: /clear queued; once it lands the fresh session gets the hello + your handoff" >&2
else
  echo "gent-clear: /clear queued; the fresh session will be re-greeted (no handoff) once it lands" >&2
fi
