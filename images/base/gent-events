#!/usr/bin/env python3
"""gent-events — the box's unified event bus.

ONE append-only stream ($GENT_STATE_DIR/events.jsonl, default ~/.local/state/gent)
carries EVERY async wake-up — inbound telegram, due reminders, and whatever else a
box wires in — and the agent arms ONE Monitor on `gent-events watch`. Box-supervised
sources (the schedule daemon, the telegram bridge) feed it with `gent-events emit`.
This is the gents analogue of pickle's events.jsonl: one inbox, one Monitor, many
sources. The durable per-source logs (telegram history.jsonl, schedule.jsonl) remain
the reconcile backstop — events.jsonl is the realtime surface, lossy by design if the
Monitor is down (a gap is recovered by `tg pending` / `gent-schedule due` on re-arm).

  gent-events emit <kind> [key=value ...]   append an event (ts added automatically)
  gent-events watch                         tail + format the stream (the Monitor command)
  gent-events next                          block until new events exist, print them, exit
  gent-events pending [--older-than SECS]   exit 0 if unconsumed events wait (the watchdog's probe)

`watch` is a NEWEST-WINS SINGLETON (pidfile, like the tg poller): arming a second
one stands the older one down. Duplicate watchers are otherwise invisible — the
watchdog's liveness check is a `pgrep -f "gent-events watch"`, which any number of
them satisfy — and each extra tail delivers every event again, so an agent that
ACTS on events acts twice (replies twice, sends the same poll twice). Newest-wins
because the newest watcher is the one the harness actually holds the Monitor on.

`next` is the same stream without the Monitor's 30-minute cap. The agent runs it as a
BACKGROUND Bash command (run_in_background): it blocks until at least one event exists
past a durable cursor, prints the batch, advances the cursor and EXITS — the exit is
what wakes the agent, so a quiet night wakes nobody. The agent re-arms after handling.
The cursor (events.cursor next to the stream, a byte offset into it) is written
only AFTER the batch is printed, so an event that lands between one `next` exiting and
the next one starting is simply the first thing the next one returns — no gap to
reconcile. First use starts at the END of the stream (history is not replayed); a
stream shorter than the cursor (truncated / rotated) restarts at offset 0. `next`
shares the watcher pidfile with `watch`, so newest-wins holds across both: two
waiters never consume the same events. `watch` itself is unchanged.
"""
import sys
import os
import json
import time
import signal
import datetime
import threading
import subprocess


def state_dir():
    return os.environ.get("GENT_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".local", "state", "gent")


def events_path():
    d = state_dir()
    os.makedirs(d, exist_ok=True)
    return os.environ.get("GENT_EVENTS_PATH") or os.path.join(d, "events.jsonl")


def watch_pid_path():
    d = state_dir()
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "watch.pid")


def cmd_emit(argv):
    if not argv:
        sys.exit("usage: gent-events emit <kind> [key=value ...]")
    ev = {"kind": argv[0], "ts": datetime.datetime.now(datetime.UTC).isoformat()}
    for kv in argv[1:]:
        if "=" not in kv:
            sys.exit("emit: args after <kind> must be key=value (got %r)" % kv)
        k, v = kv.split("=", 1)
        ev[k] = v
    # A single write of a small line is atomic on POSIX — concurrent sources are safe.
    with open(events_path(), "a", encoding="utf-8") as f:
        f.write(json.dumps(ev, ensure_ascii=False) + "\n")


def _fmt(ev):
    k = ev.get("kind")
    if k == "reminder":
        rid = ev.get("id", "?")
        return "⏰ Reminder [%s]: %s  (run `gent-schedule done %s` once handled)" % (
            rid, ev.get("note", ""), rid)
    if k == "telegram":
        return ev.get("line") or ev.get("text") or json.dumps(ev, ensure_ascii=False)
    if k == "schedule_error":
        return "⚠️ schedule: %s" % ev.get("msg", "")
    if k == "scheduled_run":
        name, secs = ev.get("name", "?"), ev.get("secs")
        if ev.get("ok"):
            return "✅ scheduled run %s ok (%ss)" % (name, secs)
        to = " TIMEOUT" if ev.get("timeout") else ""
        head = "❌ scheduled run %s failed%s (exit %s, %ss)" % (name, to, ev.get("exit"), secs)
        if ev.get("tail"):
            head += ":\n%s" % ev["tail"]
        if ev.get("log"):
            head += "\n  full log: %s" % ev["log"]
        return head
    extra = " ".join("%s=%s" % (kk, vv) for kk, vv in ev.items() if kk not in ("kind", "ts"))
    return "• %s %s" % (k, extra)


def _claim_watch(child):
    """Become THE watcher: take the pidfile, then stand down the moment someone
    newer takes it. Without this, a watchdog poke that lands while the Monitor is
    actually alive leaves two tails on the stream and the agent sees — and acts on
    — every event twice; nothing downstream can tell the copies apart. The guard
    polls rather than waiting on a signal so an IDLE watcher (blocked on readline,
    no events flowing) still stands down promptly."""
    path = watch_pid_path()
    mypid = os.getpid()

    def owner():
        try:
            with open(path, encoding="utf-8") as f:
                return f.read().strip()
        except OSError:
            return ""

    with open(path, "w", encoding="utf-8") as f:
        f.write(str(mypid))

    def guard():
        while True:
            time.sleep(2)
            if owner() != str(mypid):
                print("[gent-events] superseded by a newer watch (pid %s) — standing down"
                      % (owner() or "?"), flush=True)
                child.terminate()
                os._exit(0)

    threading.Thread(target=guard, daemon=True).start()


def _release_watch():
    """Drop the pidfile if it's still ours (a newer watcher's claim is left alone)."""
    path = watch_pid_path()
    try:
        with open(path, encoding="utf-8") as f:
            if f.read().strip() != str(os.getpid()):
                return
        os.remove(path)
    except OSError:
        pass


def cmd_watch(_argv):
    path = events_path()
    open(path, "a").close()  # ensure it exists so `tail -F` has a target immediately
    # SIGTERM (how the harness retires a Monitor) must unwind, not abort — else we
    # leave a pidfile pointing at a dead process for the next debugger to puzzle over.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    p = subprocess.Popen(["tail", "-n", "0", "-F", path], stdout=subprocess.PIPE, text=True)
    _claim_watch(p)          # newest-wins: any older watcher stands down now
    try:
        for line in p.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if str(ev.get("kind", "")).startswith("self_"):
                continue  # outbound / self events don't echo back into the session
            print(_fmt(ev), flush=True)
    except KeyboardInterrupt:
        pass
    finally:
        p.terminate()
        _release_watch()


def _cursor_path():
    # Beside the stream (not in the state dir): the watchdog finds both from the stream's directory.
    return os.path.join(os.path.dirname(events_path()), "events.cursor")


def _read_cursor():
    try:
        with open(_cursor_path(), encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def _write_cursor(off):
    """Atomic replace: a crash mid-write must never leave a torn cursor."""
    path = _cursor_path()
    tmp = "%s.%d" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(str(off))
    os.replace(tmp, path)


def _read_from(path, off):
    """(events, new_offset, drops): the COMPLETE lines at/after `off`. A half-written
    last line is left for the next pass (new_offset stops before it). Unparsable lines
    fail OPEN — surfaced as a raw bullet, never silently dropped; self_* kinds are the
    only intentional drop, and are reported in `drops` (the caller logs each to stderr)."""
    with open(path, "rb") as f:
        f.seek(off)
        data = f.read()
    end = data.rfind(b"\n") + 1
    evs, drops = [], []
    for raw in data[:end].splitlines():
        line = raw.decode("utf-8", "replace").strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
            if not isinstance(ev, dict):
                raise ValueError("not an object")
        except Exception:
            evs.append({"kind": "unparsable", "line": line})
            continue
        if str(ev.get("kind", "")).startswith("self_"):
            drops.append(ev.get("kind"))
            continue
        evs.append(ev)
    return evs, off + end, drops


def _start_offset(path):
    """Where this run reads from, plus a note when the cursor could not be trusted."""
    size = os.path.getsize(path)
    cur = _read_cursor()
    if cur is None:
        return size, "no cursor yet — starting at the end of the stream (%d bytes)" % size
    if cur > size:
        return 0, "stream shrank below the cursor (%d > %d) — restarting at offset 0" % (cur, size)
    return cur, None


def cmd_next(_argv):
    path = events_path()
    open(path, "a").close()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    mypid = str(os.getpid())
    pidpath = watch_pid_path()
    with open(pidpath, "w", encoding="utf-8") as f:
        f.write(mypid)

    def mine():
        try:
            with open(pidpath, encoding="utf-8") as f:
                return f.read().strip() == mypid
        except OSError:
            return False

    try:
        off, note = _start_offset(path)
        if note:
            print("[gent-events] " + note, file=sys.stderr, flush=True)
            _write_cursor(off)
        dropped = {}   # self_* kind -> count, summarised in one line when a real event wakes us
        while True:
            if not mine():
                # Superseded: leave the cursor alone, the newer waiter owns the events.
                print("[gent-events] next superseded by a newer waiter — standing down", flush=True)
                return
            if os.path.getsize(path) < off:
                off = 0
                print("[gent-events] stream shrank below the cursor — restarting at offset 0",
                      file=sys.stderr, flush=True)
            evs, new_off, drops = _read_from(path, off)
            if evs:
                time.sleep(0.2)   # batch whatever else lands in the same burst
                evs, new_off, drops = _read_from(path, off)
                if not mine():
                    continue      # superseded during the batch window: let the top handle it
                for k in drops:
                    dropped[k] = dropped.get(k, 0) + 1
                if dropped:   # ONE line per wake: the waiter's output IS the wake text, so a line per echo buries the event
                    n = sum(dropped.values())
                    print("[gent-events] dropped %d self event%s (%s)" % (
                        n, "" if n == 1 else "s",
                        ", ".join("%s x%d" % kv for kv in sorted(dropped.items()))), file=sys.stderr)
                for ev in evs:
                    print(_fmt(ev), flush=True)
                _write_cursor(new_off)   # AFTER the print: a crash re-delivers, never loses
                return
            if new_off != off:           # only self_* / blank lines: consume, keep waiting
                for k in drops:
                    dropped[k] = dropped.get(k, 0) + 1
                off = new_off
                _write_cursor(off)
            time.sleep(0.5)
    finally:
        _release_watch()


def cmd_pending(argv):
    """Exit 0 when a printable event waits past the cursor (and, with --older-than SECS,
    the OLDEST such event is at least that old); exit 1 otherwise. Read-only."""
    min_age = 0
    if argv:
        if len(argv) != 2 or argv[0] != "--older-than":
            sys.exit("usage: gent-events pending [--older-than SECS]")
        min_age = float(argv[1])
    path = events_path()
    cur = _read_cursor()
    if cur is None or not os.path.exists(path):
        sys.exit(1)
    evs, _off, _drops = _read_from(path, 0 if cur > os.path.getsize(path) else cur)
    if not evs:
        sys.exit(1)
    try:
        ts = datetime.datetime.fromisoformat(evs[0]["ts"])
        age = (datetime.datetime.now(datetime.UTC) - ts).total_seconds()
    except Exception:
        age = min_age   # no usable ts: treat as old enough rather than hide it
    sys.exit(0 if age >= min_age else 1)


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: gent-events <emit|watch|next|pending> ...")
    cmd, rest = sys.argv[1], sys.argv[2:]
    if cmd == "emit":
        return cmd_emit(rest)
    if cmd == "watch":
        return cmd_watch(rest)
    if cmd == "next":
        return cmd_next(rest)
    if cmd == "pending":
        return cmd_pending(rest)
    sys.exit("gent-events: unknown subcommand %r (want emit|watch|next|pending)" % cmd)


if __name__ == "__main__":
    main()
